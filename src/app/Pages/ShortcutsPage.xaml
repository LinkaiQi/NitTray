<Page x:Class="NitTray.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:NitTray.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Shortcuts"
      Background="Transparent"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <!-- No ScrollViewer here: NavigationViewContentPresenter already wraps every Page
         in one, and a nested plain ScrollViewer swallows the mouse wheel. -->
    <StackPanel HorizontalAlignment="Center" MaxWidth="400" Margin="0,32,0,32">

        <!-- Master switch -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Brightness shortcuts" FontTypography="BodyStrong"
                          VerticalAlignment="Center"/>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                             IsChecked="{Binding AreShortcutsEnabled, Mode=TwoWay}"/>
        </Grid>

        <Border Height="1" Margin="0,20"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

        <!-- Bindings -->
        <ui:TextBlock Text="Shortcut keys" FontTypography="BodyStrong"
                      HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <Grid IsEnabled="{Binding AreShortcutsEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Increase brightness"
                          FontSize="12.5" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:Button Grid.Row="0" Grid.Column="1" MinWidth="156" HorizontalContentAlignment="Center"
                       Content="{Binding BrightnessUpText}"
                       Command="{Binding CaptureBrightnessUpCommand}"
                       ToolTip="Change this shortcut"/>

            <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="Decrease brightness"
                          FontSize="12.5" VerticalAlignment="Center" Margin="0,10,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:Button Grid.Row="1" Grid.Column="1" MinWidth="156" HorizontalContentAlignment="Center"
                       Margin="0,10,0,0"
                       Content="{Binding BrightnessDownText}"
                       Command="{Binding CaptureBrightnessDownCommand}"
                       ToolTip="Change this shortcut"/>

            <!-- Outside the gated grid would leave it enabled with nothing to reset;
                 safe here because the InfoBar is empty while shortcuts are off. -->
            <ui:Button Grid.Row="2" Grid.Column="1" Content="Restore defaults"
                       HorizontalAlignment="Right" Margin="0,12,0,0"
                       Command="{Binding RestoreDefaultsCommand}"/>
        </Grid>

        <ui:InfoBar Margin="0,16,0,0" IsClosable="False"
                    Severity="{Binding StatusSeverity}"
                    Message="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus}"/>

        <Border Height="1" Margin="0,20"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="Each press changes brightness by 10%."/>
        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Margin="0,6,0,0"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="Windows may block shortcuts while an app running as administrator is in front."/>
    </StackPanel>
</Page>
